rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /intake/{documentId} {
      allow create: if request.resource.data.keys().hasOnly([
        'clientName',
        'email',
        'phone',
        'eventType',
        'eventDate',
        'guestCount',
        'package',
        'deliveryChannels',
        'contactImportMethod',
        'preferredTemplate',
        'style',
        'details',
        'guestListNotes',
        'submitted_at'
      ])
      && request.resource.data.clientName is string
      && request.resource.data.email is string
      && request.resource.data.phone is string
      && request.resource.data.eventType is string
      && request.resource.data.details is string
      && (!('deliveryChannels' in request.resource.data) || request.resource.data.deliveryChannels is string)
      && (!('contactImportMethod' in request.resource.data) || request.resource.data.contactImportMethod is string)
      && (!('guestListNotes' in request.resource.data) || request.resource.data.guestListNotes is string)
      && request.resource.data.clientName.size() <= 120
      && request.resource.data.email.size() <= 180
      && request.resource.data.phone.size() <= 80
      && request.resource.data.eventType.size() <= 80
      && request.resource.data.details.size() <= 3000
      && (!('guestListNotes' in request.resource.data) || request.resource.data.guestListNotes.size() <= 3000);
      allow read, update, delete: if false;
    }

    match /rsvps/{documentId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name',
        'email',
        'phone',
        'response',
        'guests',
        'notes',
        'event_slug',
        'guest_id',
        'invitation_url',
        'submitted_at'
      ])
      && request.resource.data.name is string
      && request.resource.data.response is string
      && request.resource.data.name.size() <= 120
      && request.resource.data.response.size() <= 40;
      allow read, update, delete: if false;
    }

    match /guestbook/{documentId} {
      allow create: if request.resource.data.keys().hasOnly([
        'author',
        'message',
        'event_slug',
        'guest_id',
        'invitation_url',
        'submitted_at'
      ])
      && request.resource.data.author is string
      && request.resource.data.message is string
      && request.resource.data.author.size() <= 60
      && request.resource.data.message.size() <= 500;
      allow read, update, delete: if false;
    }

    // User profiles — owner-only access
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /events/{eventId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'ownerId',
            'title',
            'eventType',
            'eventDate',
            'venue',
            'city',
            'guestCount',
            'template',
            'deliveryChannels',
            'notes',
            'sentCount',
            'responseCount',
            'status',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.ownerId == userId
          && request.resource.data.title is string
          && request.resource.data.eventType is string
          && request.resource.data.status is string
          && request.resource.data.sentCount is int
          && request.resource.data.responseCount is int
          && request.resource.data.title.size() <= 120
          && request.resource.data.eventType.size() <= 80
          && request.resource.data.status.size() <= 40
          && (!('eventDate' in request.resource.data) || request.resource.data.eventDate is string)
          && (!('venue' in request.resource.data) || request.resource.data.venue is string)
          && (!('city' in request.resource.data) || request.resource.data.city is string)
          && (!('guestCount' in request.resource.data) || request.resource.data.guestCount is string)
          && (!('template' in request.resource.data) || request.resource.data.template is string)
          && (!('deliveryChannels' in request.resource.data) || request.resource.data.deliveryChannels is string)
          && (!('notes' in request.resource.data) || request.resource.data.notes is string)
          && (!('venue' in request.resource.data) || request.resource.data.venue.size() <= 140)
          && (!('city' in request.resource.data) || request.resource.data.city.size() <= 80)
          && (!('notes' in request.resource.data) || request.resource.data.notes.size() <= 1000);
        allow update, delete: if false;
      }
    }
  }
}
